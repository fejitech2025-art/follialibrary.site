# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=

# MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# Frontend
FRONTEND_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional browser push notifications (generate a VAPID key pair; never expose the private key)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# For cross-site frontend/API deployments, keep both cookies secure over HTTPS.
# Production defaults to None; local development defaults to Lax.
SESSION_COOKIE_SAMESITE=
CSRF_COOKIE_SAMESITE=

# Email
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# CORS
CORS_ALLOWED_ORIGINS=
# Cloudflare R2 media storage. Keep credentials in the backend environment only.
R2_BUCKET_NAME=your-r2-bucket
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Optional override; otherwise generated from CLOUDFLARE_ACCOUNT_ID.
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REGION=auto
R2_PUBLIC_DOMAIN=
